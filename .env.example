# Credencial de Higgsfield en formato key-id:key-secret (solo servidor)
HF_CREDENTIALS=
# Código que compartes con tus colegas para entrar en la web
APP_ACCESS_CODE=
# Cadena aleatoria larga para firmar la sesión
SESSION_SECRET=
# Duración máxima por vídeo en segundos (4–30)
MAX_DURATION=15
# Descuento de tu cuenta de Higgsfield en % (15 por defecto; 30 si Seedance es uno de tus 3 modelos con descuento máximo)
PRICE_DISCOUNT=15
